rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 🛍️ 字庫商店集合：所有人皆可公開讀取，登入者可發布
    match /storeDecks/{deckId} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if request.auth != null && (resource == null || resource.data.authorId == request.auth.uid);
    }

    // 👤 其他全域功能：需登入帳號
    match /{path=**} {
      allow read, write: if request.auth != null;
    }
  }
}