rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 🛠️ 輔助函式：檢查是否已登入
    function isSignedIn() {
      return request.auth != null;
    }

    // 🛠️ 輔助函式：先確認文件存在再驗證管理員身分（避免新帳號尚未建檔時報錯）
    function isAdmin() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // 👤 使用者資料庫 (金幣、角色與暱稱)
    match /users/{userId} {
      allow read: if isSignedIn();

      // 允許新帳號建檔時初始化預設的 role: 'user' 與 coins: 0（但禁止自設 admin 或偷改高金額）
      allow create: if isSignedIn() && request.auth.uid == userId 
        && (!('role' in request.resource.data) || request.resource.data.role == 'user')
        && (!('coins' in request.resource.data) || request.resource.data.coins == 0);

      // 允許修改個人資料；禁止修改 role，且若原本已有 coins 則禁止任意竄改
      allow update: if isSignedIn() && request.auth.uid == userId 
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['coins']) ||
          (!('coins' in resource.data) && request.resource.data.coins == 0)
        );

      // 管理員擁有最高寫入權限
      allow write: if isAdmin();

      // 📦 單字庫大容量分片子集合 (突破單檔 1MB 上限)
      match /deckChunks/{chunkId} {
        allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }
    }

    // 🛍️ 社群字庫商店 (storeDecks 與其底下所有單字分片子集合)
    match /storeDecks/{deckId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        resource == null || 
        resource.data.authorId == request.auth.uid || 
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloads', 'downloadCount'])
      );
      allow delete: if isSignedIn() && 
        (resource == null || resource.data.authorId == request.auth.uid || isAdmin());

      match /{subcollection=**} {
        allow read: if true;
        allow write: if isSignedIn();
      }
    }

    // 📢 官方公告集合 (announcements)
    match /announcements/{annId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 💬 交流聊天室與訊息防禦 (chats)
    match /chats/{chatId} {
      allow read, create: if isSignedIn();
      allow update: if isSignedIn() && (request.auth.uid in resource.data.members || isAdmin());
      allow delete: if isAdmin();

      match /messages/{msgId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.senderUid == request.auth.uid;
        allow delete: if isAdmin();
      }
    }

    // 📩 好友申請與群組邀請
    match /friendRequests/{reqId} {
      allow read, write: if isSignedIn();
    }

    match /groupInvites/{invId} {
      allow read, write: if isSignedIn();
    }

    // 🌐 預設安全備援
    match /{document=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
